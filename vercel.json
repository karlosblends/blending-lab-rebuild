{
  "cleanUrls": true,
  "trailingSlash": false,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/xcare-website",
      "destination": "/xcare",
      "permanent": true
    },
    {
      "source": "/xcelerate-auto-admin-portal",
      "destination": "/xcare",
      "permanent": true
    },
    {
      "source": "/xcare-warranty-purchase-process",
      "destination": "/xcare",
      "permanent": true
    },
    {
      "source": "/design",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/design.html",
      "destination": "/about",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
