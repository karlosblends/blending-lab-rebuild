PUBLIC_SANITY_PROJECT_ID=13xgtq6v
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2026-08-05
PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
DESIGN_SYSTEM_PASSWORD=choose-a-long-unique-password

# Project planner — server-only credentials (never prefix these with PUBLIC_)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy SUPABASE_SERVICE_ROLE_KEY is supported if an existing project uses it.
RESEND_API_KEY=
PLANNER_EMAIL_FROM=
PLANNER_EMAIL_TO=karlo@blending-lab.com
# Local development uses a labelled demo engine and disk storage without credentials.
PLANNER_DATA_DIR=.local/planner
# Unapproved example figures are off by default and can only be enabled locally.
PLANNER_DEMO_ESTIMATES=false
