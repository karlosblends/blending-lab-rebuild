---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import HrFooter from "./hr/HrFooter.astro";
import OfferQuestionnaire from "./OfferQuestionnaire";
import TextReveal from "./TextReveal.astro";
import GoogleAdsVisual from "./GoogleAdsVisual.astro";
import LandingPageVisual from "./LandingPageVisual.astro";
import TrackingVisual from "./TrackingVisual.astro";
import "../text-reveal.css";
import "../styles/landing-offer.css";
import { Plus, ArrowUpRight } from "lucide-react";
import { landingOffer } from "../data/landing-offer.js";
const { lang = "hr" } = Astro.props;
const c = landingOffer[lang];
const path = lang === "hr" ? "/landing-stranice" : "/landing-pages";
---
<BaseLayout lang={lang} page={path} bodyClass="offer-page" seoOverride={{ title: c.title, description: c.description, url: `https://blending-lab.com${path}`, ogImage: "https://blending-lab.com/og-image/og-image.jpg" }}>
  <Fragment slot="head">
    <link rel="alternate" hreflang="hr" href="https://blending-lab.com/landing-stranice" />
    <link rel="alternate" hreflang="en" href="https://blending-lab.com/landing-pages" />
  </Fragment>
  <a class="offer-skip" href="#main">{c.skip}</a>
  <Header active={path} contactHref="#kontakt" />
  <main id="main">
    <section class="hero offer-hero">
      <div class="container--medium offer-hero-layout">
        <div class="hero__content">
          <TextReveal html={c.headline} class="hero__heading-gradient" />
          <p class="hero__lead">{c.intro}</p>
          <div class="button-row">
            <a class="button" href="#kontakt">{c.cta}</a>
            <a class="button button--ghost" href="mailto:karlo@blending-lab.com">{c.emailCta}</a>
          </div>
        </div>
        <img class="offer-hero-portrait" src="/assets/images/IMG-9214-from-Lightroom-1-p-1080.jpg" alt="Karlo Osman" width="1080" height="720" fetchpriority="high" />
      </div>
    </section>

    <section class="section--small offer-deliverables" aria-label={lang === "hr" ? "Što dobivate" : "What’s included"}>
      <div class="container--medium">
        <div class="feature-grid offer-feature-grid">
          {c.services.map(([title, text], index) => <article class="feature-item"><h2>{title}</h2><p>{text}</p>{index === 0 && <LandingPageVisual lang={lang} />}{index === 1 && <GoogleAdsVisual lang={lang} />}{index === 2 && <TrackingVisual lang={lang} />}</article>)}
        </div>
      </div>
    </section>

    <section class="section" id="supera" aria-labelledby="supera-title">
      <div class="container--medium offer-case">
        <div class="offer-case-copy">
          <h2 id="supera-title">{c.caseHeading}</h2>
          <p>{c.caseBody}</p>
          <a class="button button--ghost offer-case-link" href={c.caseUrl} target="_blank" rel="noopener noreferrer">{c.caseVisit}<ArrowUpRight size={18} aria-hidden="true" /></a>
        </div>
        <div class="offer-case-preview">
          <h3>{c.caseTitle}</h3>
          <a class="offer-case-image" href={c.caseUrl} target="_blank" rel="noopener noreferrer" aria-label={c.caseVisit}>
            <img src="/assets/projects/supera/landing-long.jpg" alt={c.caseAlt} width="1280" height="1800" loading="lazy" decoding="async" />
          </a>
        </div>
      </div>
    </section>

    <section class="section" id="prepoznajete-li" aria-labelledby="problem-title">
      <div class="container--medium offer-problems">
        <div class="section-title"><h2 id="problem-title">{c.problemTitle}</h2><p>{c.problemIntro}</p></div>
        <OfferQuestionnaire lang={lang} client:load />
        <noscript><p>{lang === "hr" ? "Za upitnik uključite JavaScript ili mi se javite putem obrasca." : "Enable JavaScript for the questionnaire, or use the contact form."} <a href="#kontakt">{c.cta}</a></p></noscript>
      </div>
    </section>

    <section class="section" id="karlo">
      <div class="container--medium offer-about">
        <img src="/assets/images/About-me-p-1080.webp" alt="Karlo Osman" width="1080" height="1620" loading="lazy" />
        <div><h2>{c.personTitle}</h2><p>{c.personBody}</p><p>{c.personMore}</p></div>
      </div>
    </section>

    <section class="section">
      <div class="container--medium faq-layout offer-faq">
        <h2>{c.faqTitle}</h2>
        <div class="faq-list">
          {c.faqs.map(([question, answer]) => <details class="offer-faq-item"><summary>{question}<Plus size={20} aria-hidden="true" /></summary><p>{answer}</p></details>)}
        </div>
      </div>
    </section>

    <section class="section" id="kontakt">
      <div class="container--medium contact-grid">
        <div class="contact-side">
          <div><h2>{c.contactTitle}</h2><p class="hero__lead">{c.contactIntro}</p></div>
          <div class="offer-contact-email"><a href="mailto:karlo@blending-lab.com">karlo@blending-lab.com</a></div>
        </div>
        <div class="form-card">
          <h3>{c.formTitle}</h3>
          <form class="offer-form" action="https://formspree.io/f/xpqgddeg" method="POST" data-offer-form data-sending={c.sending} data-success={c.success} data-error={c.error} aria-describedby="form-status">
            <input type="hidden" name="_subject" value={`Blending Lab — landing page & Google Ads enquiry (${lang})`} />
            <input type="hidden" name="source" value={path} />
            <div class="form-grid">
              <div><label for="offer-name">{c.fields.name}</label><input id="offer-name" name="name" autocomplete="name" required maxlength="150" /></div>
              <div><label for="offer-email">{c.fields.email}</label><input id="offer-email" name="email" type="email" autocomplete="email" required maxlength="254" /></div>
              <div class="field--full"><label for="offer-company">{c.fields.website} <span class="muted">({c.fields.optional})</span></label><input id="offer-company" name="company" autocomplete="organization" maxlength="300" /></div>
              <div class="field--full"><label for="offer-message">{c.fields.message}</label><textarea id="offer-message" name="message" rows="3" required maxlength="6000" placeholder={c.fields.placeholder}></textarea></div>
            </div>
            <div class="offer-honeypot" aria-hidden="true"><label for="offer-trap">Leave empty</label><input id="offer-trap" name="_gotcha" tabindex="-1" autocomplete="off" /></div>
            <p id="form-status" class="form-note" role="status" aria-live="polite" aria-atomic="true"></p>
            <div class="button-row"><button class="button" type="submit"><span data-submit-label>{c.submit}</span></button></div>
            <p class="offer-privacy">{c.privacy} <a href="/privacy-policy.html">{c.privacyLink}</a></p>
          </form>
        </div>
      </div>
    </section>
    <div class="container--medium offer-language" aria-label={lang === "hr" ? "Jezik stranice" : "Page language"}><a href="/landing-stranice" lang="hr" aria-current={lang === "hr" ? "page" : undefined}>Hrvatski</a><a href="/landing-pages" lang="en" aria-current={lang === "en" ? "page" : undefined}>English</a></div>
  </main>
  <HrFooter />
  <script>
      import { track } from "../lib/analytics.js";
      import { initOfferDisclosures } from "../scripts/offer-disclosures";
      initOfferDisclosures();

      const form = document.querySelector<HTMLFormElement>("[data-offer-form]");
      form?.addEventListener("submit", async event => {
        event.preventDefault();
        if (form.getAttribute("aria-busy") === "true") return;
        const status = form.querySelector<HTMLElement>("[role=status]")!;
        const button = form.querySelector<HTMLButtonElement>("[type=submit]")!;
        const label = button.querySelector<HTMLElement>("[data-submit-label]")!;
        const original = label.textContent;
        button.disabled = true;
        form.setAttribute("aria-busy", "true");
        label.textContent = form.dataset.sending!;
        status.textContent = form.dataset.sending!;
        status.classList.remove("is-error", "is-success");
        try {
          const response = await fetch(form.action, {
            method: "POST", body: new FormData(form), headers: { Accept: "application/json" },
            signal: AbortSignal.timeout(20000),
          });
          if (!response.ok) throw new Error("Submission failed");
          track("generate_lead", { form_id: "landing_contact" });
          status.textContent = form.dataset.success!;
          status.classList.add("is-success");
          form.reset();
        } catch {
          track("form_error", { form_id: "landing_contact", error_type: "submission" });
          status.textContent = form.dataset.error!;
          status.classList.add("is-error");
        } finally {
          button.disabled = false;
          label.textContent = original;
          form.setAttribute("aria-busy", "false");
        }
      });
    </script>
</BaseLayout>
