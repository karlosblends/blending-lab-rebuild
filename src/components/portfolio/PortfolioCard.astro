---
import { img } from "../../lib/assets.js";

const { project, priority = false } = Astro.props;
const presentation = project.portfolio;
const media = presentation.media?.length ? presentation.media : [project.coverImage].filter(Boolean);
const titleId = `portfolio-project-${project.slug}`;
const frameLabels = ["Overview", "Inside the work", "Closer look"];
---

<article class:list={["karlo-project", `karlo-project--${presentation.format || "standard"}`]} data-preview-card aria-labelledby={titleId}>
    <div class="karlo-project__media" data-preview-surface>
      <a class="karlo-project__visual-link" href={`/karlo/${project.slug}`} aria-label={`Explore ${project.title}`} data-karlo-project>
      {media.map((source, index) => (
        <img
          class:list={["karlo-project__frame", index === 0 && "is-active"]}
          src={index === 0 ? img(source) : undefined}
          data-preview-src={index > 0 ? img(source) : undefined}
          alt=""
          loading={index === 0 && priority ? "eager" : "lazy"}
          decoding="async"
          fetchpriority={index === 0 && priority ? "high" : "auto"}
        />
      ))}
      </a>
    </div>
    <div class="karlo-project__caption">
      <div class="karlo-project__caption-heading">
        <h2 id={titleId}><a href={`/karlo/${project.slug}`} data-karlo-project>{project.title}</a></h2>
        {media.length > 1 && <div class="karlo-preview-controls" role="group" aria-label={`${project.title} preview images`}>
          {media.map((_, index) => <button type="button" data-preview-select={index} aria-pressed={index === 0 ? "true" : "false"} aria-label={`Show ${project.title}: ${frameLabels[index] || `image ${index + 1}`}`}><span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span></button>)}
        </div>}
      </div>
      <div>
        <ul aria-label="Project disciplines">
          {presentation.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      </div>
      <p>{presentation.summary}</p>
    </div>
</article>
