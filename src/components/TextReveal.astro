---
// Hero words are rendered on the server so the entrance starts on first paint.
const { html, class: className = "" } = Astro.props;
const parts = html.split(/(<[^>]+>)/g).flatMap((part) =>
  part.startsWith("<") ? [part] : part.split(/(\s+)/)
);
const count = parts.filter((part) => part && !/^(<|\s)/.test(part)).length;
const step = Math.min(65, 420 / Math.max(count - 1, 1));
let index = 0;
const words = parts.map((part) => {
  if (!part || /^(<|\s)/.test(part)) return part;
  return `<span class="text-reveal__clip"><span class="text-reveal__word" style="--word-delay:${120 + index++ * step}ms">${part}</span></span>`;
}).join("");
---

<h1 class:list={[className, "text-reveal", "text-reveal--hero", "is-text-visible"]} data-text-reveal>
  <span class="text-reveal__accessible" set:html={html} />
  <span class="text-reveal__visual" aria-hidden="true" set:html={words} />
</h1>
