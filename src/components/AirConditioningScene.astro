---
const { idPrefix = "landing-ac" } = Astro.props;
---
<svg class="ac-scene" viewBox="0 0 300 170" fill="none" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <defs>
    <linearGradient id={`${idPrefix}-wall`} x1="0" y1="0" x2="300" y2="170" gradientUnits="userSpaceOnUse"><stop stop-color="#d1cfc6" /><stop offset="1" stop-color="#efede5" /></linearGradient>
    <linearGradient id={`${idPrefix}-unit`} x1="112" y1="32" x2="112" y2="91" gradientUnits="userSpaceOnUse"><stop stop-color="#fff" /><stop offset=".72" stop-color="#eeefeb" /><stop offset="1" stop-color="#c4c8c4" /></linearGradient>
    <linearGradient id={`${idPrefix}-glass`} x1="241" y1="0" x2="300" y2="150" gradientUnits="userSpaceOnUse"><stop stop-color="#e4edec" /><stop offset="1" stop-color="#b6c8c6" /></linearGradient>
  </defs>
  <path fill={`url(#${idPrefix}-wall)`} d="M0 0h300v170H0z" />
  <path fill="#faf8ef" fill-opacity=".38" d="m239 18 61 26v126H92z" />
  <path d="M244 0h56v148h-56z" fill={`url(#${idPrefix}-glass)`} stroke="#a6aaa3" stroke-width="3" />
  <path d="M240 0v151h60M276 0v148M244 76h56" stroke="#f8f8ef" stroke-width="5" />
  <path d="M0 148h240" stroke="#c0c0b7" />
  <path d="M0 151h240v19H0z" fill="#c4c1b5" />
  <g class="ac-unit">
  <rect x="29" y="40" width="176" height="58" rx="10" fill="#6e7770" fill-opacity=".13" />
  <rect x="27" y="32" width="176" height="58" rx="10" fill={`url(#${idPrefix}-unit)`} stroke="#bbc1bc" stroke-width=".7" />
  <path d="M33 72h164" stroke="#c6cbc6" />
  <path d="M39 79h152l-4 5H43z" fill="#697873" />
  <path d="M44 81h142" stroke="#aeb9b2" stroke-width="1.2" />
  <circle cx="187" cy="65" r="1.5" fill="#7faaa0" />
  <path d="M64 99c-6 10 8 14 2 25M112 99c-6 10 8 14 2 25M160 99c-6 10 8 14 2 25" stroke="#7c9d96" stroke-opacity=".5" stroke-width="1.5" stroke-linecap="round" />
  </g>
  <rect x="213" y="104" width="13" height="19" rx="2" fill="#eeefe8" stroke="#bbc1b7" />
  <path d="M216 109h7v5h-7z" fill="#a6b6ac" />
</svg>
<style>
  .ac-scene { display: block; width: 100%; height: 100%; }
  @container (max-width: 265px) { .ac-unit { transform: translate(54px, 7px) scale(.77); } }
</style>
