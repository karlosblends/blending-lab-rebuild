---
import { img } from "../lib/assets.js";
import { projectImageDimensions } from "../data/project-image-dimensions.js";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import ContactForm from "./ContactForm.astro";

const { project, projects = [] } = Astro.props;

const contextItems = [
  ["Role", project.role || project.service],
  ["Scope", project.deliverables],
  ["Focus", project.expertise || project.industry],
  ["Platform", project.platform],
].filter(([, value]) => value);

const fallbackSections = [
  {
    type: "statement",
    eyebrow: "Situation",
    title: "A focused piece of digital product or website work.",
    body: project.pageIntro || project.company,
  },
  {
    type: "textImage",
    eyebrow: "Design role",
    title: project.proofLine ? "What this project proves" : "Turning the brief into a clearer experience",
    body: project.proofLine || project.myRole || project.about,
    image: project.gallery?.[0] || project.coverImage,
    caption: "A closer look at the project interface.",
    align: "right",
  },
  ...(project.gallery?.length > 1
    ? [
        {
          type: "twoImage",
          title: "Additional product surfaces",
          body: "Supporting screens show how the visual system carries through the experience without forcing every asset into the same thumbnail grid.",
          images: project.gallery.slice(1, 3).map((src) => ({ src })),
        },
      ]
    : []),
];

const caseStudy = project.caseStudy || {};
const sections = caseStudy.sections?.length ? caseStudy.sections : fallbackSections;
const contextEntries = caseStudy.context || contextItems;
const showContext = caseStudy.showContext !== false && contextEntries.length;
const showContextCopy = caseStudy.intro !== false;
const editorialSections = [];
for (let index = 0; index < sections.length; index += 1) {
  const section = sections[index];
  const nextSection = sections[index + 1];
  if (section.type === "twoImage" && nextSection?.type === "fullImage") {
    editorialSections.push({ type: "editorialGallery", section, feature: nextSection, index });
    index += 1;
  } else {
    editorialSections.push({ type: "section", section, index });
  }
}
const heroImage = caseStudy.heroImage || project.coverImage;
const heroAlt = caseStudy.heroAlt || `${project.title} project interface`;
const heroTreatment = caseStudy.heroTreatment || "immersive";
const nextProject =
  (caseStudy.nextProjectSlug && projects.find((item) => item.slug === caseStudy.nextProjectSlug)) ||
  projects[(projects.findIndex((item) => item.slug === project.slug) + 1) % projects.length] ||
  projects.find((item) => item.slug !== project.slug);

const imageLabel = (label = "Open image larger") => label;
const imageSource = (imageItem = {}) => imageItem.src || imageItem.image;
const imageFrameClasses = ["case-image-button"];
const imageAttributes = (source) => {
  const dimensions = projectImageDimensions[source];
  return dimensions ? { src: img(source), width: dimensions.width, height: dimensions.height } : { src: img(source) };
};
const itemLabel = (item) => (typeof item === "string" ? item : item.label);
const itemText = (item) => (typeof item === "string" ? "" : item.text);
const escapeHtml = (value = "") =>
  String(value).replace(/[&<>"']/g, (character) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[character]);
const bodyItems = (body) => {
  if (!body) return [];
  return (Array.isArray(body) ? body : [body]).map((paragraph) => (typeof paragraph === "string" ? { text: paragraph } : paragraph)).filter(Boolean);
};
const bodyHtml = (body) =>
  bodyItems(body)
    .map((paragraph) => {
      const lead = paragraph.lead ? `<strong>${escapeHtml(paragraph.lead)}</strong>${paragraph.text ? " " : ""}` : "";
      return `<p>${lead}${escapeHtml(paragraph.text || "")}</p>`;
    })
    .join("");
const heroImageSettings = {
  src: heroImage,
  objectPosition: caseStudy.heroPosition,
};
---

<Header active="projects.html" />
<main class:list={["case-study", project.slug && `case-study--${project.slug}`]}>
  <section class="case-hero section">
    <div class="case-container">
      <div class="case-hero__content reveal">
        <p class="case-label">{caseStudy.label || `${project.title} · ${project.industry || project.service}`}</p>
        <h1>{caseStudy.headline || project.title}</h1>
        <p class="case-hero__lead">{caseStudy.summary || project.description}</p>
      </div>
    </div>
  </section>

  <section class:list={["case-hero-visual", `case-hero-visual--${heroTreatment}`]}>
    <div class="case-visual-container">
      {
        heroImage ? (
          <figure class="case-visual case-visual--hero reveal">
            <button class:list={imageFrameClasses} type="button" data-lightbox-image={img(heroImage)} data-lightbox-alt={heroAlt} aria-label={imageLabel("Open hero image larger")}>
              <img class="case-image-button__image" {...imageAttributes(heroImage)} alt={heroAlt} decoding="async" fetchpriority="high" />
            </button>
            {caseStudy.heroCaption && <figcaption>{caseStudy.heroCaption}</figcaption>}
          </figure>
        ) : (
          <div class="case-cover--empty reveal"><span>Cover image coming soon</span></div>
        )
      }
    </div>
  </section>

  {
    showContext && (
      <section class="case-section case-section--context" id="project-context">
        <div class="case-container">
          <div class="case-context reveal">
            {
              showContextCopy && (
                <div class="case-context__copy">
                  <p class="case-section-label">{caseStudy.intro?.eyebrow || "Project context"}</p>
                  <h2>{caseStudy.intro?.title || "What needed to be designed"}</h2>
                  <Fragment set:html={bodyHtml(caseStudy.intro?.body || project.pageIntro || project.company)} />
                  {
                    project.liveUrl && (
                      <a class="case-text-link" href={project.liveUrl} target="_blank" rel="noreferrer">
                        {project.liveLabel || "View live project"}
                      </a>
                    )
                  }
                </div>
              )
            }
            <dl class="case-context__meta" aria-label="Project facts">
              {contextEntries.map(([label, value]) => (
                <div class="case-meta">
                  <dt>{label}</dt>
                  <dd>{value}</dd>
                </div>
              ))}
            </dl>
          </div>
        </div>
      </section>
    )
  }

  {
    editorialSections.map((item) => {
      const { section, index } = item;
      const feature = item.feature;

      return (
      <section
        class:list={[
          "case-section",
          item.type === "editorialGallery" ? "case-section--editorialGallery" : `case-section--${section.type}`,
          section.tone && `case-section--${section.tone}`,
        ]}
        id={section.id}
      >
        <div class:list={["case-container", item.type === "section" && section.type === "fullImage" && section.size === "bleed" && "case-container--bleed"]}>
          {item.type === "editorialGallery" && (
            <div class="case-editorial-gallery">
              {(section.title || section.body) && (
                <div class="case-editorial-gallery__copy reveal">
                  {section.eyebrow && <p class="case-section-label">{section.eyebrow}</p>}
                  {section.title && <h2>{section.title}</h2>}
                  <Fragment set:html={bodyHtml(section.body)} />
                </div>
              )}
              <div class="case-editorial-gallery__grid">
                {section.images?.map((imageItem, imageIndex) => (
                  <figure class="case-visual reveal">
                    <button class:list={imageFrameClasses} type="button" data-lightbox-image={img(imageSource(imageItem))} data-lightbox-alt={imageItem.alt || `${project.title} related visual ${imageIndex + 1}`} aria-label={imageLabel()}>
                      <img class="case-image-button__image" {...imageAttributes(imageSource(imageItem))} alt={imageItem.alt || ""} loading="lazy" decoding="async" />
                    </button>
                    {imageItem.caption && <figcaption>{imageItem.caption}</figcaption>}
                  </figure>
                ))}
              </div>
              <figure class:list={["case-visual", "case-visual--full", "case-editorial-gallery__feature", "reveal", feature?.crop && "case-visual--crop"]}>
                <button class:list={imageFrameClasses} type="button" data-lightbox-image={img(imageSource(feature))} data-lightbox-alt={feature.alt || `${project.title} full project visual`} aria-label={imageLabel()}>
                  <img class="case-image-button__image" {...imageAttributes(imageSource(feature))} alt={feature.alt || ""} loading="lazy" decoding="async" />
                </button>
                {feature.caption && <figcaption>{feature.caption}</figcaption>}
              </figure>
            </div>
          )}

          {item.type === "section" && section.type === "statement" && (
            <div class="case-statement reveal">
              {section.eyebrow && <p class="case-section-label">{section.eyebrow}</p>}
              <div class="case-statement__content">
                {section.title && <h2>{section.title}</h2>}
                <Fragment set:html={bodyHtml(section.body)} />
              </div>
            </div>
          )}

          {item.type === "section" && section.type === "textImage" && (
            <div class:list={["case-split", section.align === "left" && "case-split--reverse", section.scale === "wide" && "case-split--wide-image"]}>
              <div class="case-split__copy reveal">
                {section.eyebrow && <p class="case-section-label">{section.eyebrow}</p>}
                <h2>{section.title}</h2>
                <Fragment set:html={bodyHtml(section.body)} />
              </div>
              <figure class:list={["case-visual", "reveal", section.scale === "crop" && "case-visual--crop"]}>
                <button class:list={imageFrameClasses} type="button" data-lightbox-image={img(imageSource(section))} data-lightbox-alt={section.alt || `${project.title} case study image ${index + 1}`} aria-label={imageLabel()}>
                  <img class="case-image-button__image" {...imageAttributes(imageSource(section))} alt={section.alt || ""} loading="lazy" decoding="async" />
                </button>
                {section.caption && <figcaption>{section.caption}</figcaption>}
              </figure>
            </div>
          )}

          {item.type === "section" && section.type === "fullImage" && (
            <>
              {(section.title || section.body) && (
                <div class="case-composition__copy reveal">
                  {section.eyebrow && <p class="case-section-label">{section.eyebrow}</p>}
                  {section.title && <h2>{section.title}</h2>}
                  <Fragment set:html={bodyHtml(section.body)} />
                </div>
              )}
              <figure class:list={["case-visual", "case-visual--full", "reveal", section.size === "bleed" && "case-visual--bleed", section.crop && "case-visual--crop"]}>
                <button class:list={imageFrameClasses} type="button" data-lightbox-image={img(imageSource(section))} data-lightbox-alt={section.alt || `${project.title} full project visual`} aria-label={imageLabel()}>
                  <img class="case-image-button__image" {...imageAttributes(imageSource(section))} alt={section.alt || ""} loading="lazy" decoding="async" />
                </button>
                {section.caption && <figcaption>{section.caption}</figcaption>}
              </figure>
            </>
          )}

          {item.type === "section" && section.type === "twoImage" && (
            <div class:list={["case-composition", section.ratio && `case-composition--${section.ratio}`]}>
              {(section.title || section.body) && (
                <div class="case-composition__copy reveal">
                  {section.eyebrow && <p class="case-section-label">{section.eyebrow}</p>}
                  {section.title && <h2>{section.title}</h2>}
                  <Fragment set:html={bodyHtml(section.body)} />
                </div>
              )}
              <div class="case-composition__images">
                {section.images?.map((imageItem, imageIndex) => (
                  <figure class="case-visual reveal">
                    <button class:list={imageFrameClasses} type="button" data-lightbox-image={img(imageSource(imageItem))} data-lightbox-alt={imageItem.alt || `${project.title} related visual ${imageIndex + 1}`} aria-label={imageLabel()}>
                      <img class="case-image-button__image" {...imageAttributes(imageSource(imageItem))} alt={imageItem.alt || ""} loading="lazy" decoding="async" />
                    </button>
                    {imageItem.caption && <figcaption>{imageItem.caption}</figcaption>}
                  </figure>
                ))}
              </div>
            </div>
          )}

          {item.type === "section" && section.type === "itemGrid" && (
            <div class:list={["case-statement", "case-statement--items", "reveal"]}>
              {section.eyebrow && <p class="case-section-label">{section.eyebrow}</p>}
              <div class:list={["case-statement__content", "case-item-block", section.columns && `case-item-block--${section.columns}`]}>
                {(section.title || section.body) && (
                  <div class="case-item-block__copy">
                    {section.title && (section.headingLevel === "h3" ? <h3>{section.title}</h3> : <h2>{section.title}</h2>)}
                    <Fragment set:html={bodyHtml(section.body)} />
                  </div>
                )}
                <div class="case-item-grid">
                  {section.items?.map((gridItem, itemIndex) => (
                    <article class="case-item reveal">
                      {section.numbered && <span>{String(itemIndex + 1).padStart(2, "0")}</span>}
                      <div class="case-item__copy">
                        <strong>{itemLabel(gridItem)}</strong>
                        {itemText(gridItem) && <p>{itemText(gridItem)}</p>}
                      </div>
                    </article>
                  ))}
                </div>
                {section.note && <p class="case-note">{section.note}</p>}
              </div>
            </div>
          )}
        </div>
      </section>
      );
    })
  }

  {
    nextProject && (
      <section class="case-section case-section--next">
        <div class="case-container">
          <a class="case-next reveal" href={`/${nextProject.caseStudyUrl}`}>
            <figure class="case-next__media">
              <img src={img(nextProject.coverImage)} alt="" loading="lazy" decoding="async" />
            </figure>
            <div class="case-next__copy">
              <span>Next project</span>
              <strong>{nextProject.title}</strong>
              <em>{nextProject.description}</em>
            </div>
          </a>
        </div>
      </section>
    )
  }
</main>
<ContactForm caseStudy />
<Footer />
