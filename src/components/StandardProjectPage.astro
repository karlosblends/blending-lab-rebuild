---
import { img } from "../lib/assets.js";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import ContactForm from "./ContactForm.astro";
import Gallery from "./Gallery.astro";

const { project } = Astro.props;
const metaItems = [
  ["Role", project.role || project.service],
  ["Deliverables", project.deliverables],
  ["Expertise", project.expertise || project.industry],
].filter(([, value]) => value);
const introHeading = project.pageIntro ? "Overview" : "The company";
const introText = project.pageIntro || project.company;
const roleHeading = project.proofLine ? "What this shows" : "My role";
const roleText = project.proofLine || project.myRole || project.about;
---

<Header active="projects.html" />
<main class="case-hero section">
  <div class="container">
    <div class="hero__content reveal">
      <h2>{project.title}</h2>
      <p class="hero__lead">{project.description}</p>
    </div>
    {
      project.coverImage ? (
        <figure class="case-cover reveal">
          <img src={img(project.coverImage)} alt="" decoding="async" fetchpriority="high" />
        </figure>
      ) : (
        <div class="case-cover case-cover--empty reveal"><span>Cover image coming soon</span></div>
      )
    }
    <div class="case-meta-grid reveal">
      {metaItems.map(([label, value]) => <div class="case-meta"><span class="muted">{label}</span><h4>{value}</h4></div>)}
    </div>
  </div>
</main>
<section class="section case-body">
  <div class="container">
    <div class="rich-text reveal">
      <h2>{introHeading}</h2>
      <p>{introText}</p>
      {
        project.liveUrl && (
          <div class="case-actions">
            <a class="button button--ghost" href={project.liveUrl} target="_blank" rel="noreferrer">
              {project.liveLabel || "View live project"}
            </a>
          </div>
        )
      }
      <h2>{roleHeading}</h2>
      <p>{roleText}</p>
      {
        project.services?.length > 0 && (
          <>
            <h2>Services</h2>
            <div class="service-tags">
              {project.services.map((service) => <span>{service}</span>)}
            </div>
          </>
        )
      }
    </div>
    <Gallery images={project.gallery} />
  </div>
</section>
<ContactForm />
<Footer />
