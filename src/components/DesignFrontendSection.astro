---
import WeeklyPerformanceCard from "./WeeklyPerformanceCard.astro";

const codeSnippetHtml = [
  '<span class="code-token code-token--keyword">const</span> days = [',
  '  [<span class="code-token code-token--string">"Mon"</span>, <span class="code-token code-token--string">"10"</span>, <span class="code-token code-token--number">52.87</span>],',
  '  [<span class="code-token code-token--string">"Tue"</span>, <span class="code-token code-token--string">"11"</span>, <span class="code-token code-token--number">117.6</span>],',
  '  [<span class="code-token code-token--string">"Wed"</span>, <span class="code-token code-token--string">"12"</span>, <span class="code-token code-token--number">182.97</span>],',
  '  [<span class="code-token code-token--string">"Thu"</span>, <span class="code-token code-token--string">"13"</span>, <span class="code-token code-token--number">248.34</span>],',
  '  [<span class="code-token code-token--string">"Fri"</span>, <span class="code-token code-token--string">"14"</span>, <span class="code-token code-token--number">314.34</span>],',
  '  [<span class="code-token code-token--string">"Sat"</span>, <span class="code-token code-token--string">"15"</span>, <span class="code-token code-token--number">379.71</span>],',
  '];',
  '',
  '<span class="code-token code-token--tag">&lt;article</span> <span class="code-token code-token--attr">class</span>=<span class="code-token code-token--string">"weekly-performance-card"</span><span class="code-token code-token--tag">&gt;</span>',
  '  <span class="code-token code-token--tag">&lt;h3</span> <span class="code-token code-token--attr">class</span>=<span class="code-token code-token--string">"weekly-performance-card__title"</span><span class="code-token code-token--tag">&gt;</span>Weekly Performance<span class="code-token code-token--tag">&lt;/h3&gt;</span>',
  '  {days.map(([day, date, x]) =&gt; (',
  '    <span class="code-token code-token--tag">&lt;div</span> <span class="code-token code-token--attr">style</span>={`--day-x:${x}`}<span class="code-token code-token--tag">&gt;</span>{day}<span class="code-token code-token--tag">&lt;strong&gt;</span>{date}<span class="code-token code-token--tag">&lt;/strong&gt;&lt;/div&gt;</span>',
  '  ))}',
  '  <span class="code-token code-token--tag">&lt;img</span> <span class="code-token code-token--attr">class</span>=<span class="code-token code-token--string">"weekly-performance-card__area"</span> <span class="code-token code-token--attr">src</span>={chartAsset(<span class="code-token code-token--string">"area-fill"</span>)} <span class="code-token code-token--tag">/&gt;</span>',
  '  <span class="code-token code-token--tag">&lt;img</span> <span class="code-token code-token--attr">class</span>=<span class="code-token code-token--string">"weekly-performance-card__trend"</span> <span class="code-token code-token--attr">src</span>={chartAsset(<span class="code-token code-token--string">"trend-line"</span>)} <span class="code-token code-token--tag">/&gt;</span>',
  '  <span class="code-token code-token--tag">&lt;img</span> <span class="code-token code-token--attr">class</span>=<span class="code-token code-token--string">"weekly-performance-card__active-line"</span> <span class="code-token code-token--attr">src</span>={chartAsset(<span class="code-token code-token--string">"active-line"</span>)} <span class="code-token code-token--tag">/&gt;</span>',
  '  <span class="code-token code-token--tag">&lt;dl</span> <span class="code-token code-token--attr">class</span>=<span class="code-token code-token--string">"weekly-performance-card__stats"</span><span class="code-token code-token--tag">&gt;</span>{stats.map(([label, value]) =&gt; ...)}<span class="code-token code-token--tag">&lt;/dl&gt;</span>',
  '<span class="code-token code-token--tag">&lt;/article&gt;</span>',
].join("\n");
---

<section class="section design-frontend-section">
  <div class="container">
    <div class="design-frontend-section__copy reveal">
      <h2>Most designers hand you a Figma file. I hand you the built frontend.</h2>
      <p>
        I design the product thinking and the interface, then build it into clean, production-ready frontend code - pixel-perfect to the design, reusable components, ready for your team to wire up. One person from first flow to shipped screen, and you own the code: no builder, no lock-in, no monthly platform fees.
      </p>
    </div>

    <div class="design-code-split reveal" aria-label="Rendered interface component and matching frontend code">
      <div class="design-code-split__preview" aria-label="Rendered weekly performance component">
        <WeeklyPerformanceCard />
      </div>

      <figure class="design-code-split__code">
        <figcaption>WeeklyPerformanceCard.astro</figcaption>
        <pre aria-label="Trimmed real component code"><code set:html={codeSnippetHtml} /></pre>
      </figure>
    </div>

    <p class="design-frontend-section__proof">This site is hand-coded - no template, no builder. So is my work.</p>
  </div>
</section>
