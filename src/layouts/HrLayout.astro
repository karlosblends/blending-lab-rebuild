---
import "../styles.css";
import "../hr.css";
import { img } from "../lib/assets.js";

const {
  title = "Blending Lab — strategija, dizajn i development",
  description = "Blending Lab je mali studio iz Zagreba koji povezuje strategiju, sadržaj, dizajn i custom development.",
} = Astro.props;
---

<!doctype html>
<html lang="hr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, follow" />
    <title>{title}</title>
    <link rel="icon" href={img("favicon.png")} />
    <link rel="apple-touch-icon" href={img("webclip.png")} />
  </head>
  <body class="hr-body">
    <slot />
  </body>
</html>
