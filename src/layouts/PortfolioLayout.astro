---
import BaseLayout from "./BaseLayout.astro";
import ProfileRail from "../components/portfolio/ProfileRail.astro";
import PortfolioNav from "../components/portfolio/PortfolioNav.astro";
import "../portfolio.css";

const {
  active = "work",
  project,
  projectTitle = "",
  page = active === "about" ? "karlo/about.html" : "karlo.html",
  title = active === "about" ? "About Karlo Osman | Product designer and design engineer" : "Karlo Osman | Product designer and design engineer",
  description = active === "about"
    ? "About Karlo Osman: product designer, design engineer, and the person behind Blending Lab."
    : "Selected product design, websites, design systems, and frontend work by Karlo Osman.",
  canonical = active === "about" ? "https://www.blending-lab.com/karlo/about" : "https://www.blending-lab.com/karlo",
} = Astro.props;
---

<BaseLayout
  page={page}
  project={project}
  bodyClass="karlo-portfolio-page"
  seoOverride={{ title, description, ogTitle: title, url: canonical }}
>
  <script is:inline>
    try {
      document.body.dataset.karloTheme = localStorage.getItem("karlo-theme") === "dark" ? "dark" : "light";
    } catch {
      document.body.dataset.karloTheme = "light";
    }
  </script>
  <a class="karlo-skip-link" href="#karlo-content">Skip to content</a>
  <div class="karlo-shell">
    <ProfileRail />
    <div class="karlo-content-column">
      <PortfolioNav active={active} projectTitle={projectTitle} />
      <slot />
    </div>
  </div>

  <script>
    const themeButton = document.querySelector<HTMLButtonElement>("button[data-karlo-theme]");
    const setTheme = (dark: boolean) => {
      document.body.dataset.karloTheme = dark ? "dark" : "light";
      themeButton?.setAttribute("aria-pressed", String(dark));
      themeButton?.setAttribute("aria-label", `Switch to ${dark ? "light" : "dark"} appearance`);
      const label = themeButton?.querySelector("[data-theme-label]");
      if (label) label.textContent = dark ? "Light mode" : "Dark mode";
    };
    try { setTheme(localStorage.getItem("karlo-theme") === "dark"); } catch { setTheme(false); }
    themeButton?.addEventListener("click", () => {
      const dark = document.body.dataset.karloTheme !== "dark";
      setTheme(dark);
      try { localStorage.setItem("karlo-theme", dark ? "dark" : "light"); } catch {}
    });
    const copyButton = document.querySelector<HTMLButtonElement>("[data-copy-email]");
    let copyReset: number;
    copyButton?.addEventListener("click", async () => {
      const feedback = document.querySelector("[data-copy-feedback]");
      const label = copyButton.querySelector("[data-copy-label]");
      try {
        await navigator.clipboard.writeText(copyButton.dataset.copyEmail || "");
        if (label) label.textContent = "Email copied";
        if (feedback) feedback.textContent = "Email address copied to clipboard.";
      } catch {
        if (feedback) feedback.textContent = copyButton.dataset.copyEmail || "";
      }
      clearTimeout(copyReset);
      copyReset = window.setTimeout(() => {
        if (label) label.textContent = "Copy email address";
        if (feedback) feedback.textContent = "";
      }, 2400);
    });
    const timeNodes = document.querySelectorAll("[data-karlo-time]");
    const updateLocalTime = () => {
      timeNodes.forEach((node) => {
        const timezone = node.getAttribute("data-timezone") || "Europe/Zagreb";
        node.textContent = new Intl.DateTimeFormat("en-GB", {
          timeZone: timezone,
          hour: "2-digit",
          minute: "2-digit",
          hour12: false,
        }).format(new Date());
      });
    };
    updateLocalTime();
    window.setInterval(updateLocalTime, 30_000);

    const hoverCapable = window.matchMedia("(hover: hover) and (pointer: fine)");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    document.querySelectorAll("[data-preview-card]").forEach((card) => {
      const frames = Array.from(card.querySelectorAll(".karlo-project__frame"));
      const surface = card.querySelector<HTMLElement>("[data-preview-surface]");
      const controls = Array.from(card.querySelectorAll<HTMLButtonElement>("[data-preview-select]"));
      card.setAttribute("data-preview-ready", "true");
      let activeIndex = 0;
      let requestedIndex = 0;
      let manuallySelected = false;
      let hoverTimer: number;
      let hoverIndex = -1;
      let surfaceLeft = 0;
      let surfaceWidth = 1;

      const ensureFrame = (frame) => {
        if (!(frame instanceof HTMLImageElement) || frame.src) return;
        const source = frame.dataset.previewSrc;
        if (source) {
          frame.loading = "eager";
          frame.src = source;
        }
      };

      const setFrame = async (index) => {
        const nextIndex = Math.max(0, Math.min(frames.length - 1, index));
        requestedIndex = nextIndex;
        if (nextIndex === activeIndex) return;
        const nextFrame = frames[nextIndex];
        ensureFrame(nextFrame);
        if (nextFrame instanceof HTMLImageElement) {
          try { await nextFrame.decode(); } catch { return; }
        }
        if (requestedIndex !== nextIndex) return;
        frames[activeIndex]?.classList.remove("is-active");
        frames[nextIndex]?.classList.add("is-active");
        activeIndex = nextIndex;
        controls.forEach((button, index) => button.setAttribute("aria-pressed", String(index === activeIndex)));
      };

      controls.forEach((button, index) => button.addEventListener("click", () => {
        manuallySelected = true;
        clearTimeout(hoverTimer);
        setFrame(index);
      }));

      controls.forEach((button, index) => button.addEventListener("keydown", (event) => {
        if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
        event.preventDefault();
        const next = (index + (event.key === "ArrowRight" ? 1 : -1) + controls.length) % controls.length;
        controls[next]?.focus();
        controls[next]?.click();
      }));

      if (hoverCapable.matches && !reduceMotion.matches && frames.length > 1 && surface) {
        surface.addEventListener("pointerenter", () => {
          const rect = surface.getBoundingClientRect();
          surfaceLeft = rect.left;
          surfaceWidth = Math.max(rect.width, 1);
          frames.forEach(ensureFrame);
        });
        surface.addEventListener("pointermove", (event) => {
          if (manuallySelected || card.contains(document.activeElement) || reduceMotion.matches) return;
          const progress = (event.clientX - surfaceLeft) / surfaceWidth;
          const index = Math.max(0, Math.min(frames.length - 1, Math.floor(progress * frames.length)));
          if (index === hoverIndex) return;
          hoverIndex = index;
          clearTimeout(hoverTimer);
          hoverTimer = window.setTimeout(() => setFrame(index), 180);
        });
        surface.addEventListener("pointerleave", () => {
          clearTimeout(hoverTimer);
          hoverIndex = -1;
          if (!manuallySelected) setFrame(0);
        });
      }

      if (!reduceMotion.matches && hoverCapable.matches) {
        const preloadObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              ensureFrame(frames[1]);
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: "240px" }
        );
        preloadObserver.observe(card);
      }
    });

    document.querySelectorAll("[data-karlo-project]").forEach((link) => {
      link.addEventListener("click", () => window.posthog?.capture("portfolio_project_selected", { surface: "karlo" }));
    });
  </script>
</BaseLayout>
