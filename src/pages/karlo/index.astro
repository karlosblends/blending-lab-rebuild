---
import PortfolioLayout from "../../layouts/PortfolioLayout.astro";
import PortfolioGrid from "../../components/portfolio/PortfolioGrid.astro";
import { getProjects } from "../../lib/sanity.js";
import { getPortfolioProjects } from "../../data/portfolio.js";

const projects = getPortfolioProjects(await getProjects());
---

<PortfolioLayout active="work">
  <main class="karlo-work" id="karlo-content">
    <header class="karlo-selected-heading" id="selected-work">
      <h1>Selected work</h1>
      <p>Product design, websites, and the frontend behind them.</p>
    </header>
    <PortfolioGrid projects={projects} />
    <footer class="karlo-footer-note">
      <span>Made carefully in Zagreb.</span>
      <a href="/projects">See the complete Blending Lab archive</a>
    </footer>
  </main>
</PortfolioLayout>
