---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectPlanner from "../components/planner/ProjectPlanner.jsx";
import "../components/arc/foundation.css";
import "../components/planner/planner.css";
---

<BaseLayout
  bodyClass="planner-page"
  analyticsEnabled={false}
  seoOverride={{ title: "Plan your project — Blending Lab", description: "Work through your website or product idea, explore the likely scope and send a clear project brief to Blending Lab.", url: "https://blending-lab.com/planner" }}
>
  <ProjectPlanner client:load />
  <noscript><p class="planner-noscript">The project planner needs JavaScript. You can also <a href="mailto:karlo@blending-lab.com">email Karlo about your project</a>.</p></noscript>
</BaseLayout>
