---
import "../styles.css";
import { priceList, currentPriceList, isPriceListPublishable, formatPrice, formatDate, priceListFilename } from "../data/service-price-list.js";

export const prerender = false;
const published = isPriceListPublishable();
if (import.meta.env.PROD && !published) return new Response("Not found", { status: 404 });
const previousVersions = priceList.versions.slice(0, -1).toReversed();
const csvPath = (version) => `/cjenici/${priceListFilename(version)}`;
---

<!doctype html>
<html lang="hr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Cjenik i način obračuna — Blending Lab</title>
    <meta name="description" content="Satnica za dizajn i razvoj, način ugovaranja projektnih usluga i cjenik Blending Laba za preuzimanje." />
    {!published && <meta name="robots" content="noindex, nofollow" />}
    {published && <link rel="canonical" href="https://blending-lab.com/cjenik" />}
    <link rel="icon" href="/assets/images/favicon.png" />
    <link rel="preload" href="/assets/fonts/Satoshi-Variable.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="price-page">
    <a class="skip-link" href="#sadrzaj">Preskoči na sadržaj</a>
    <div class="price-shell">
      <header class="price-header">
        <a href="/" aria-label="Blending Lab — početna stranica"><img src="/assets/images/Blending Lab Logo.jpg" width="40" height="40" alt="" /><span>Blending Lab</span></a>
        <a href="mailto:hello@blending-lab.com">Kontakt <span aria-hidden="true">↗</span></a>
      </header>
      <main id="sadrzaj">
        {!published && <aside class="draft-note" aria-label="Status pripreme"><strong>Nacrt za pregled</strong><span>Stranica još nije objavljena.{!priceList.address && " Potrebno je dopuniti adresu poslovanja."}</span></aside>}
        <div class="price-intro">
          <p class="price-eyebrow">Blending Lab · Cjenik usluga</p>
          <h1>Cjenik i način<br />obračuna.</h1>
          <p class="price-lead">Cijenu i način obračuna određujemo ponudom prema opsegu i zahtjevima projekta.</p>
        </div>
        <section class="rate-section" aria-labelledby="satnica">
          <div class="section-label"><h2 id="satnica">Rad po satu</h2><p>{currentPriceList.publishedAt ? `Cjenik vrijedi od ${formatDate(currentPriceList.publishedAt)}` : "Pripremljeno 8. listopada 2026."}</p></div>
          <div class="table-wrap" role="region" aria-label="Cjenik rada po satu" tabindex="0">
            <table>
              <caption class="sr-only">Aktualna i povijesna cijena rada po satu, u eurima</caption>
              <thead><tr><th scope="col">Usluga</th><th scope="col">Aktualna cijena</th><th scope="col">Cijena na 10. 9. 2026.</th></tr></thead>
              <tbody>{currentPriceList.services.map((service) => <tr><th scope="row"><span>{service.name}</span><small>{service.scope}</small></th><td class="current-rate" data-label="Aktualna cijena">{formatPrice(service.price)}<small>/ sat</small></td><td class="reference-rate" data-label={`Cijena na ${formatDate(service.referenceDate)}`}>{formatPrice(service.referencePrice)}<small>/ sat</small></td></tr>)}</tbody>
            </table>
          </div>
          <p class="tax-note">{priceList.vatNote}</p>
          <p class="rate-description">Satnica se primjenjuje kada je u ponudi predviđen obračun po satu. Opseg rada definiramo prije početka suradnje.</p>
        </section>
        <section class="project-section" aria-labelledby="projekti">
          <h2 id="projekti">Projektne ponude</h2>
          <div><p>Za projektni angažman cijenu određujemo zasebnom ponudom, prema opsegu, složenosti i zahtjevima projekta. Objavljena satnica sama po sebi ne određuje ukupnu projektnu cijenu.</p><p>Ponuda navodi dogovorene usluge, opseg rada i ukupnu cijenu. Dodatne usluge i troškove dogovaramo prije njihova nastanka.</p></div>
        </section>
        <section class="download-section" aria-labelledby="preuzimanje">
          <div><h2 id="preuzimanje">Cjenik za preuzimanje</h2><p>{published ? "Preuzmite aktualni cjenik u CSV formatu." : "Preuzmite radnu verziju cjenika u CSV formatu."}</p></div>
          <a class="download-link" href={csvPath(currentPriceList)} download>{published ? "Preuzmi cjenik" : "Preuzmi nacrt"}<span>CSV <span aria-hidden="true">↓</span></span></a>
        </section>
        <section class="archive-section" aria-labelledby="arhiva">
          <h2 id="arhiva">Arhiva cjenika</h2>
          {previousVersions.length ? <ul>{previousVersions.map((version) => <li><a href={csvPath(version)} download>Cjenik br. {version.number} · {formatDate(version.publishedAt)} <span>CSV ↓</span></a></li>)}</ul> : <p>Prethodnih verzija cjenika još nema.</p>}
        </section>
      </main>
      <footer class="price-footer"><div><p>{priceList.legalName}</p>{priceList.address && <p>{priceList.address}</p>}<a href="mailto:hello@blending-lab.com">hello@blending-lab.com</a></div><a href="/privacy-policy.html">Pravila privatnosti</a></footer>
    </div>
  </body>
</html>

<style>
  .price-page { background: var(--charcoal); color: var(--alabaster); }
  .price-page::before { content: none; }
  .price-shell { width: min(1100px, calc(100% - 96px)); margin: 0 auto; }
  .price-header { display: flex; justify-content: space-between; align-items: center; gap: 24px; padding: 32px 0; border-bottom: 1px solid var(--onyx); }
  .price-header a:first-child { display: flex; align-items: center; gap: 14px; font-size: 18px; font-weight: 500; }
  .price-header img { width: 40px; height: 40px; }
  .price-header a:last-child { font-size: 16px; padding: 12px 0 12px 12px; }
  a:focus-visible, .table-wrap:focus-visible { outline: 2px solid var(--flamingo); outline-offset: 6px; }
  .skip-link { position: absolute; left: 16px; top: -100px; z-index: 10; padding: 12px 20px; color: var(--charcoal); background: var(--flamingo); }
  .skip-link:focus { top: 16px; }
  .draft-note { display: flex; flex-wrap: wrap; gap: 8px 24px; padding: 16px 20px; margin-top: 28px; color: var(--alto); background: var(--almost-black); border: 1px solid var(--mine-shaft); font-size: 14px; line-height: 1.5; }
  .price-intro { padding: 72px 0 64px; }
  .price-eyebrow { font-size: 13px; letter-spacing: .1em; text-transform: uppercase; color: var(--gray); margin-bottom: 24px; }
  h1 { font-size: clamp(44px, 7vw, 76px); line-height: 1.04; letter-spacing: -.045em; }
  .price-lead { max-width: 540px; margin-top: 28px; font-size: 20px; line-height: 1.5; color: var(--gray); }
  h2 { font-size: 23px; line-height: 1.25; letter-spacing: -.02em; }
  .section-label { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; align-items: baseline; margin-bottom: 24px; }
  .section-label p { font-size: 14px; color: var(--gray); }
  .table-wrap { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; text-align: left; min-width: 620px; }
  thead { background: var(--cod-gray); }
  thead th { padding: 18px 24px; font-size: 13px; font-weight: 500; color: var(--alto); }
  tbody th, tbody td { padding: 32px 24px; border-bottom: 1px solid var(--mine-shaft); vertical-align: top; }
  tbody th { width: 48%; font-size: 18px; font-weight: 500; line-height: 1.4; }
  tbody th small { display: block; max-width: 330px; font-size: 14px; font-weight: 400; line-height: 1.6; margin-top: 10px; color: var(--gray); }
  td { white-space: nowrap; font-variant-numeric: tabular-nums; }
  td small { display: block; font-size: 14px; font-weight: 400; line-height: 1.5; margin-top: 12px; color: var(--gray); }
  .current-rate { color: var(--alabaster); font-size: 34px; line-height: 1.2; letter-spacing: -.03em; }
  .reference-rate { font-size: 24px; line-height: 1.7; }
  .tax-note { font-size: 14px; margin-top: 18px; color: var(--gray); }
  .rate-description { max-width: 650px; margin-top: 24px; color: var(--alto); }
  .project-section { display: grid; grid-template-columns: 1fr 2fr; gap: 40px; padding: 48px 0; margin-top: 48px; border-top: 1px solid var(--onyx); }
  .project-section p { color: var(--alto); line-height: 1.7; }
  .project-section p + p { margin-top: 16px; }
  .download-section { padding: 32px 0; border-block: 1px solid var(--onyx); display: flex; justify-content: space-between; align-items: center; gap: 24px; }
  .download-section p { margin-top: 10px; color: var(--gray); font-size: 14px; }
  .download-link { display: flex; align-items: center; justify-content: space-between; gap: 32px; border: 1px solid var(--mine-shaft); padding: 16px 20px; font-size: 16px; white-space: nowrap; }
  .download-link:hover { background: var(--almost-black); }
  .download-link > span { color: var(--gray); font-size: 13px; }
  .archive-section { padding: 32px 0 64px; }
  .archive-section h2 { font-size: 18px; }
  .archive-section p { margin-top: 12px; font-size: 14px; color: var(--gray); }
  .archive-section ul { margin: 16px 0 0; list-style: none; padding: 0; }
  .archive-section li a { display: flex; justify-content: space-between; gap: 24px; padding: 14px 0; border-bottom: 1px solid var(--onyx); }
  .price-footer { display: flex; justify-content: space-between; align-items: flex-start; gap: 24px; padding: 28px 0 40px; border-top: 1px solid var(--onyx); }
  .price-footer p, .price-footer a { font-size: 13px; line-height: 1.8; color: var(--gray); }
  .price-footer a { display: inline-block; text-decoration: underline; text-underline-offset: 4px; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  @media (max-width: 700px) {
    .price-shell { width: calc(100% - 40px); }
    .price-header { padding: 20px 0; }
    .price-intro { padding: 48px 0 40px; }
    .price-lead { font-size: 18px; }
    .project-section { grid-template-columns: 1fr; gap: 20px; padding: 32px 0; margin-top: 32px; }
    .download-section, .price-footer { flex-direction: column; align-items: flex-start; }
    .download-link { width: 100%; }
    table { min-width: 0; }
    thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); }
    tbody tr { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    tbody th { grid-column: 1 / -1; width: auto; background: var(--cod-gray); padding: 20px 16px; }
    tbody th small { max-width: none; }
    tbody td { padding: 20px 16px; }
    tbody td::before { content: attr(data-label); display: block; white-space: normal; min-height: 40px; margin-bottom: 14px; color: var(--gray); font-size: 13px; line-height: 1.5; font-weight: 400; letter-spacing: 0; }
    .current-rate, .reference-rate { font-size: 27px; line-height: 1.2; }
  }
</style>
